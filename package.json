{
  "name": "swjeon-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:performance": "pnpm build && playwright test --config=playwright.performance.config.ts"
  },
  "dependencies": {
    "astro": "7.3.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.4.1"
}

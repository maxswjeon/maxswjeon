---
import { Image } from 'astro:assets';
import type { ExperienceWorkItem } from '../content/public';
import { experienceMedia } from '../content/experience-media';
import { ui, type Locale } from '../i18n';

interface Props {
  items: readonly ExperienceWorkItem[];
  locale?: Locale;
}

const { items, locale = 'ko' } = Astro.props;
const englishMedia = {
  'nine-account-recovery': {
    alt: 'Nine Chronicles portal account recovery screen explaining wallet connection',
    caption: 'Nine Chronicles portal account recovery',
  },
} as const;
---

<div class="mt-10 mb-0 list-none border-t border-[var(--rule-dark)] p-0 [&>article:last-child]:border-b-0 [&_article_p]:max-w-none">
  {items.map((item, index) => (
    <article class="grid grid-cols-[minmax(5rem,1fr)_minmax(0,4fr)] gap-6 border-b border-[var(--rule-dark)] py-[clamp(1.8rem,4vw,3rem)] max-[719px]:grid-cols-1 max-[719px]:gap-3">
      <span class="font-mono text-[length:var(--size-meta)] font-bold leading-[1.5] text-[var(--signal-dark)] tabular-nums">{String(index + 1).padStart(2, '0')}</span>
      <div class:list={['min-w-0', { 'grid items-start gap-7 md:grid-cols-[minmax(0,1fr)_minmax(16rem,0.72fr)]': item.media }]}>
        <div>
          <h3 class="m-0 mb-3 text-[clamp(1.4rem,2.2vw,2rem)] font-[650] tracking-[-0.035em] leading-heading">
            {item.link
              ? <a href={item.link} target="_blank" rel="noopener">{item.title} <span aria-hidden="true">↗</span></a>
              : item.title}
          </h3>
          <p class="m-0 max-w-none text-[var(--ink-soft)] text-[length:var(--size-body)] leading-copy">{item.body}</p>
          {item.links && (
            <details class="mt-6 border-t border-[var(--rule-dark)] pt-4">
              <summary class="w-fit cursor-pointer text-[var(--signal-dark)] text-[length:var(--size-small)] font-bold">{ui[locale].sourceLinks} <span class="ml-[0.35rem] font-mono text-[length:var(--size-meta)] font-normal">{item.links.length}</span></summary>
              <ul class="mt-4 mb-0 list-none p-0">
                {item.links.map((link) => (
                  <li class="[&+li]:border-t [&+li]:border-[var(--rule-dark)]">
                    <a class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 py-[0.85rem] text-[var(--ink)] text-[length:var(--size-small)] no-underline hover:text-[var(--signal-dark)] max-[719px]:grid-cols-1 max-[719px]:gap-[0.2rem]" href={link.href} target="_blank" rel="noopener">
                      <span>{link.label}</span>
                      <small class="text-right font-mono text-[var(--ink-soft)] text-[length:var(--size-meta)] max-[719px]:text-left">{link.source} ↗</small>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
        {item.media && (() => {
          const media = experienceMedia[item.media];
          const localized = locale === 'en' ? englishMedia[item.media] : undefined;
          return (
            <figure class="m-0">
              <Image
                class="block h-auto w-full border border-[var(--rule-dark)]"
                src={media.src}
                alt={localized?.alt ?? media.alt}
                widths={[480, 720, media.src.width]}
                sizes="(max-width: 767px) calc(100vw - 4rem), 30vw"
                loading="lazy"
              />
              <figcaption class="mt-3 font-mono text-sm leading-meta text-[var(--ink-soft)]">{localized?.caption ?? media.caption}</figcaption>
            </figure>
          );
        })()}
      </div>
    </article>
  ))}
</div>

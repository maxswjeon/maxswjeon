---
import { Image } from 'astro:assets';
import type { ExperienceWorkItem } from '../content/public';
import { experienceMedia } from '../content/experience-media';
import { ui, type Locale } from '../i18n';

interface Props {
  items: readonly ExperienceWorkItem[];
  locale?: Locale;
}

const { items, locale = 'ko' } = Astro.props;
const englishMedia = {
  'nine-account-recovery': {
    alt: 'Nine Chronicles portal account recovery screen explaining wallet connection',
    caption: 'Nine Chronicles portal account recovery',
  },
} as const;
---

<ul class="mt-6 grid gap-7 border-l-2 border-rule pl-5 split:pl-6">
  {items.map((item) => (
    <li class:list={['min-w-0', { 'grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(14rem,0.8fr)]': item.media }]}>
      <div>
        <h4 class="text-[1.125rem] leading-heading font-bold tracking-[-0.02em] text-balance">
          {item.link
            ? <a href={item.link} target="_blank" rel="noopener">{item.title} <span aria-hidden="true">↗</span></a>
            : item.title}
        </h4>
        <p class="mt-1 text-body text-soft">{item.body}</p>
        {item.links && (
          <details class="mt-3">
            <summary class="w-fit text-meta font-semibold text-signal">{ui[locale].sourceLinks} <span class="font-normal tabular-nums">{item.links.length}</span></summary>
            <ul class="mt-2 divide-y divide-rule border-y border-rule">
              {item.links.map((link) => (
                <li>
                  <a class="grid gap-0.5 py-2.5 text-meta no-underline hover:text-signal split:grid-cols-[minmax(0,1fr)_auto] split:gap-4" href={link.href} target="_blank" rel="noopener">
                    <span class="text-ink">{link.label}</span>
                    <small class="text-meta text-soft">{link.source} ↗</small>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
      {item.media && (() => {
        const media = experienceMedia[item.media];
        const localized = locale === 'en' ? englishMedia[item.media] : undefined;
        return (
          <figure>
            <Image
              class="block h-auto w-full rounded-xl border border-rule bg-white"
              src={media.src}
              alt={localized?.alt ?? media.alt}
              widths={[480, 720, media.src.width]}
              sizes="(min-width: 64rem) 22vw, (min-width: 53.75rem) 24rem, calc(100vw - 4rem)"
              loading="lazy"
            />
            <figcaption class="mt-2 text-meta text-soft">{localized?.caption ?? media.caption}</figcaption>
          </figure>
        );
      })()}
    </li>
  ))}
</ul>

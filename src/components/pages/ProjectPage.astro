---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entry from '../ui/Entry.astro';
import PageHead from '../ui/PageHead.astro';
import Tags from '../ui/Tags.astro';
import { projectMedia } from '../../content/project-media';
import type { Project, ProjectGroup } from '../../content/public';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  project: Project;
  projectGroupLabels: Record<ProjectGroup, string>;
}

const { locale, project, projectGroupLabels } = Astro.props;
const media = projectMedia[project.slug] ?? [];
const copy = locale === 'ko' ? {
  organizations: '관련 조직',
  context: '배경',
  contribution: '기여',
  change: '변화',
  status: '상태',
  viewGitHub: 'GitHub에서 보기',
  projectLinks: '프로젝트 링크',
  back: '작업 목록으로 돌아가기',
  gallery: '프로젝트 이미지',
  source: '출처',
} : {
  organizations: 'Related organizations',
  context: 'Context',
  contribution: 'Contribution',
  change: 'Change',
  status: 'Status',
  viewGitHub: 'View on GitHub',
  projectLinks: 'Project links',
  back: 'Back to all work',
  gallery: 'Project images',
  source: 'Source',
};
const englishMedia: Record<string, readonly { alt: string; caption: string }[]> = {
  'coryose-process': [{ alt: 'Administration screen showing notices and purchase-order statistics for the workflow management solution', caption: 'Workflow management administration screen' }],
  'bear-oj': [{ alt: 'Start screen for the YCC online judge', caption: 'Online judge start screen' }],
  'yonsei-mileage': [{ alt: 'Course mileage records and course information at Yonsei University', caption: 'Course mileage and course information search' }],
  'outta-certificates': [{ alt: 'OUTTA certificate center administration screen for editing certificate backgrounds and text', caption: 'Certificate background and text editor' }],
  'spacey-passion': [{ alt: 'SpaceY website showing the schedule and venue for a talk', caption: 'SpaceY talk schedule and venue' }],
  clubroom: [{ alt: 'The “Who’s in the Clubroom?” service showing real-time occupancy beside a door illustration', caption: 'Real-time clubroom occupancy screen' }],
  fairtrade: [{ alt: 'FairTrade Android app showing product information after a barcode scan', caption: 'Android result screen from the public repository' }],
};
const breadcrumbs = [
  { name: 'Home', path: `/${locale}/` },
  { name: 'Work', path: `/${locale}/work/` },
  { name: project.title, path: `/${locale}/work/${project.slug}/` },
];
const label = 'text-label font-bold text-ink';
const action = 'font-bold text-signal';
---

<BaseLayout title={project.title} description={project.summary} pathname={`/${locale}/work/${project.slug}/`} {breadcrumbs} {locale}>
  <PageHead lines={project.title}>
    <Tags items={[projectGroupLabels[project.group], ...project.eyebrow.split(' · ')]} />
    {project.organizations && (
      <ul class="mt-3 flex flex-wrap gap-x-4 text-meta text-soft" aria-label={copy.organizations}>
        {project.organizations.map((organization) => <li><a href={organization.href} target="_blank" rel="noopener">{organization.label} ↗</a></li>)}
      </ul>
    )}
    <p class="mt-8 max-w-[40rem] text-body text-soft">{project.summary}</p>
  </PageHead>

  {media.length > 0 && (
    <section class="mt-14 grid gap-8" aria-label={`${project.title} ${copy.gallery}`}>
      {media.map((item, index) => {
        const localized = locale === 'en' ? englishMedia[project.slug]?.[index] : undefined;
        return (
          <figure class:list={[item.layout === 'portrait' && 'w-[min(100%,24rem)]']}>
            <Image
              class="block h-auto w-full rounded-xl border border-rule bg-white"
              src={item.src}
              alt={localized?.alt ?? item.alt}
              widths={item.layout === 'portrait' ? [320, item.src.width] : [640, 960, item.src.width]}
              sizes={item.layout === 'portrait' ? '(min-width: 30rem) 24rem, calc(100vw - 2rem)' : '(min-width: 53.75rem) 60vw, calc(100vw - 2rem)'}
              loading="lazy"
            />
            <figcaption class="mt-2 flex flex-wrap justify-between gap-x-4 gap-y-1 text-meta text-soft">
              <span>{localized?.caption ?? item.caption}</span>
              {item.source && <a class="text-signal" href={item.source} target="_blank" rel="noopener">{copy.source} ↗</a>}
            </figcaption>
          </figure>
        );
      })}
    </section>
  )}

  <div class="mt-section divide-y divide-rule border-y border-rule">
    <Entry as="section" padding="py-8" aria-labelledby="context">
      <h2 slot="meta" class={label} id="context">{copy.context}</h2>
      <p class="text-body">{project.problem}</p>
    </Entry>
    <Entry as="section" padding="py-8" aria-labelledby="contribution">
      <h2 slot="meta" class={label} id="contribution">{copy.contribution}</h2>
      <p class="text-body">{project.contribution}</p>
    </Entry>
    <Entry as="section" padding="py-8" aria-labelledby="change">
      <h2 slot="meta" class={label} id="change">{copy.change}</h2>
      <p class="text-body">{project.change}</p>
    </Entry>
    <Entry as="section" padding="py-8" aria-labelledby="status">
      <h2 slot="meta" class={label} id="status">{copy.status}</h2>
      <p class="rounded-xl border border-rule bg-white px-5 py-4 text-body">{project.status}</p>
      {project.link && <p class="mt-5"><a class={action} href={project.link} target="_blank" rel="noopener">{copy.viewGitHub} <span aria-hidden="true">↗</span></a></p>}
      {project.links && (
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2" aria-label={`${project.title} ${copy.projectLinks}`}>
          {project.links.map((link) => <li><a class={action} href={link.href} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      )}
    </Entry>
  </div>

  <p class="mt-12"><a class={action} href={getRelativeLocaleUrl(locale, 'work')}>{copy.back}</a></p>
</BaseLayout>

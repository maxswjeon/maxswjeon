---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceWorkList from '../ExperienceWorkList.astro';
import Entry from '../ui/Entry.astro';
import PageHead from '../ui/PageHead.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Tags from '../ui/Tags.astro';
import { experienceMedia } from '../../content/experience-media';
import type { ExperienceWorkItem, Project, ProjectGroup } from '../../content/public';
import { period, type Locale } from '../../i18n';

interface ExperienceEntry {
  id: string;
  organization: string;
  role: string;
  period: string;
  body: string;
  work?: readonly ExperienceWorkItem[];
  link?: string;
  organizationLinks?: readonly { label: string; href: string }[];
}

interface Props {
  locale: Locale;
  projectGroups: readonly { id: ProjectGroup; label: string; title: string }[];
  primaryExperience: ExperienceEntry;
  experienceEntries: readonly ExperienceEntry[];
  companyWork: readonly ExperienceWorkItem[];
  projects: Project[];
  smallTools: readonly { title: string; body: string; link: string }[];
}

const { locale, projectGroups, primaryExperience, experienceEntries, companyWork, projects, smallTools } = Astro.props;
const copy = locale === 'ko' ? {
  description: '경력과 외주·개인·학교·동아리 프로젝트, 개발 도구를 소개합니다.',
  heading: ['문제를 이해하고', '오래 쓸 수 있는 흐름으로 바꿉니다'],
  intro: '제품과 운영, 인프라의 경계를 오가며 사람의 수고를 줄이는 일을 해왔습니다.',
  experience: '경력',
  projectsTitle: '프로젝트 모음',
  relatedOrganizations: '관련 조직',
  toolsTitle: '개발자의 반복 작업을 덜어내는 도구',
  archive: '이전 프로젝트 아카이브',
} : {
  description: 'Professional experience, client work, personal, school, and community projects, and developer tools.',
  heading: ['Start with the problem', 'Build to last'],
  intro: 'Experience spans product engineering, operations, and infrastructure, with a consistent focus on reducing manual effort.',
  experience: 'Experience',
  projectsTitle: 'Projects',
  relatedOrganizations: 'Related organizations',
  toolsTitle: 'Tools that reduce repetitive development work',
  archive: 'Browse earlier projects',
};
const breadcrumbs = [
  { name: 'Home', path: `/${locale}/` },
  { name: 'Work', path: `/${locale}/work/` },
];
const experienceMediaCopy = locale === 'ko' ? {} : {
  zible: {
    alt: 'Three mobile screens from ZIBLE showing login and scrapbook features',
    caption: 'ZIBLE mobile service screens',
  },
};
const experience = [{ ...primaryExperience, work: companyWork }, ...experienceEntries];
const stretched = 'no-underline after:absolute after:inset-0 after:rounded-xl group-hover:text-signal';
---

<BaseLayout title="Work" description={copy.description} pathname={`/${locale}/work/`} {breadcrumbs} {locale}>
  <PageHead lines={copy.heading} keepLines={locale === 'ko'}>
    <p class="mt-8 max-w-[40rem] text-body text-soft">{copy.intro}</p>
  </PageHead>

  <section class="mt-section" aria-labelledby="experience-title">
    <SectionTitle id="experience-title" lines={copy.experience} />
    <div class="mt-4 divide-y divide-rule border-y border-rule">
      {experience.map((item) => {
        const media = experienceMedia[item.id];
        const localizedMedia = experienceMediaCopy[item.id as keyof typeof experienceMediaCopy];
        return (
          <Entry as="article" id={item.id} class="scroll-mt-8" padding="py-10">
            <Fragment slot="meta">
              <span class="block font-semibold text-ink">{period(item.period)}</span>
              {item.role.split(' · ').map((part) => <span class="block">{part}</span>)}
            </Fragment>
            <h3 class="text-[1.5rem] leading-[1.3] font-bold tracking-[-0.03em] text-balance">
              {item.link
                ? <a href={item.link} target="_blank" rel="noopener">{item.organization} <span aria-hidden="true">↗</span></a>
                : item.organization}
            </h3>
            {item.organizationLinks && (
              <ul class="mt-2 flex flex-wrap gap-x-4 text-meta text-soft" aria-label={`${item.organization} ${copy.relatedOrganizations}`}>
                {item.organizationLinks.map((organization) => <li><a href={organization.href} target="_blank" rel="noopener">{organization.label} ↗</a></li>)}
              </ul>
            )}
            <p class="mt-3 text-body text-soft">{item.body}</p>
            {item.work && <ExperienceWorkList items={item.work} {locale} />}
            {media && (
              <figure class="mt-8 max-w-[34rem]">
                <Image
                  class="block h-auto w-full rounded-xl border border-rule bg-white"
                  src={media.src}
                  alt={localizedMedia?.alt ?? media.alt}
                  widths={[640, 960, media.src.width]}
                  sizes="(min-width: 80rem) 34rem, (min-width: 53.75rem) 40vw, calc(100vw - 2rem)"
                  loading="lazy"
                />
                <figcaption class="mt-2 text-meta text-soft">{localizedMedia?.caption ?? media.caption}</figcaption>
              </figure>
            )}
          </Entry>
        );
      })}
    </div>
  </section>

  <section class="mt-section" aria-labelledby="projects-title">
    <SectionTitle id="projects-title" lines={copy.projectsTitle} />
    {projectGroups.map((group) => {
      const groupProjects = projects.filter((project) => project.group === group.id);
      return groupProjects.length > 0 && (
        <section class="mt-10" aria-labelledby={`project-group-${group.id}`}>
          <h3 class="border-b border-rule pb-3 text-label font-bold text-soft" id={`project-group-${group.id}`}>{group.title}</h3>
          {groupProjects.map((project) => (
            <Entry as="article" link>
              {project.organizations && (
                <ul slot="meta" class="flex flex-wrap gap-x-3 split:grid split:gap-y-1" aria-label={`${project.title} ${copy.relatedOrganizations}`}>
                  {project.organizations.map((organization) => <li><a class="relative z-10 inline-flex min-h-6 items-center" href={organization.href} target="_blank" rel="noopener">{organization.label} ↗</a></li>)}
                </ul>
              )}
              <h4 class="text-[1.1875rem] leading-heading font-bold tracking-[-0.02em]">
                <a class={stretched} href={getRelativeLocaleUrl(locale, `work/${project.slug}`)}>{project.title}</a>
              </h4>
              <p class="mt-1.5 text-body text-soft">{project.summary}</p>
              <Tags items={project.eyebrow.split(' · ')} />
            </Entry>
          ))}
        </section>
      );
    })}
  </section>

  <section class="mt-section" aria-labelledby="tools-title">
    <SectionTitle id="tools-title" lines={copy.toolsTitle} />
    <ul class="mt-2">
      {smallTools.map((tool) => (
        <Entry as="li" link>
          <h3 class="text-[1.1875rem] leading-heading font-bold tracking-[-0.02em]">
            <a class={stretched} href={tool.link} target="_blank" rel="noopener">{tool.title} <span aria-hidden="true">↗</span></a>
          </h3>
          <p class="mt-1.5 text-body text-soft">{tool.body}</p>
        </Entry>
      ))}
    </ul>
    <p class="mt-4"><a class="font-bold text-signal" href={getRelativeLocaleUrl(locale, 'work/archive')}>{copy.archive}</a></p>
  </section>
</BaseLayout>

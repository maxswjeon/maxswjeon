---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entry from '../ui/Entry.astro';
import PageHead from '../ui/PageHead.astro';
import { site } from '../../config';
import type { Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = locale === 'ko' ? {
  description: 'swjeon.kr의 선택적 방문 분석과 추적 설정 안내입니다.',
  heading: '방문 분석과 선택권',
  intro: '상세 이용 분석과 마케팅 측정은 동의한 경우에만 시작합니다.',
  essential: '필수 기능은 페이지 제공과 추적 설정 저장에 사용됩니다.',
  analytics: '분석은 방문한 페이지, 유입 경로, 기기·브라우저 같은 사용 정보를 집계해 사이트 개선에 활용할 수 있습니다.',
  interaction: '분석에 동의하면 Microsoft Clarity가 클릭·스크롤과 같은 상호작용을 기록할 수 있습니다. 마케팅은 Kakao Pixel과 Google 광고 측정에 사용됩니다.',
  unavailable: '설정되지 않은 서비스나 식별자는 로드되지 않습니다. 분석과 마케팅 동의를 각각 선택할 수 있습니다.',
  control: '선택은 이 브라우저에 저장됩니다. 언제든지 설정을 다시 열어 변경할 수 있으며 동의를 철회하면 페이지를 새로 불러온 뒤 해당 도구를 로드하지 않습니다. 이미 공급자에게 전달된 데이터와 저장된 쿠키가 자동으로 삭제되지는 않습니다.',
  open: '추적 설정 열기',
  contact: '개인정보와 관련한 문의는',
  contactEnd: '로 보낼 수 있습니다.',
} : {
  description: 'How optional analytics work on swjeon.kr and how to manage tracking preferences.',
  heading: 'Your data, your choices',
  intro: 'Detailed analytics and marketing measurement start only with your consent.',
  essential: 'Essential functions deliver the site and save your tracking preferences.',
  analytics: 'Analytics may collect aggregate information about visited pages, referrers, devices, and browsers to improve the site.',
  interaction: 'With analytics enabled, Microsoft Clarity may record interactions such as clicks and scrolling. Marketing consent covers Kakao Pixel and Google Ads measurement.',
  unavailable: 'Services without a configured identifier are never loaded. Analytics and marketing preferences can be managed independently.',
  control: 'Your preferences are stored in this browser and can be changed at any time. Withdrawing consent prevents those tools from loading after the page is refreshed. It does not automatically delete cookies or data already sent to a provider.',
  open: 'Open tracking settings',
  contact: 'For questions about privacy, email',
  contactEnd: '.',
};
const breadcrumbs = [{ name: 'Home', path: `/${locale}/` }, { name: 'Privacy', path: `/${locale}/privacy/` }];
const labels = locale === 'ko'
  ? { categories: '수집 범위', control: '선택과 철회', contact: '문의', essential: '필수 기능', analytics: '분석' }
  : { categories: 'What is collected', control: 'Your choices', contact: 'Contact', essential: 'Essential functions', analytics: 'Analytics' };
const label = 'text-label font-bold text-ink';
---

<BaseLayout title="Privacy" description={copy.description} pathname={`/${locale}/privacy/`} {breadcrumbs} {locale}>
  <PageHead lines={copy.heading}>
    <p class="mt-8 max-w-[40rem] text-body text-soft">{copy.intro}</p>
  </PageHead>
  <div class="mt-section divide-y divide-rule border-y border-rule">
    <Entry as="section" padding="py-10" aria-labelledby="categories">
      <h2 slot="meta" class={label} id="categories">{labels.categories}</h2>
      <div class="grid gap-4 text-body">
        <p><strong>{labels.essential}</strong>{copy.essential.replace(labels.essential, '')}</p>
        <p><strong>{labels.analytics}</strong>{copy.analytics.replace(labels.analytics, '')}</p>
        <p>{copy.interaction}</p>
        <p>{copy.unavailable}</p>
      </div>
    </Entry>
    <Entry as="section" padding="py-10" aria-labelledby="control">
      <h2 slot="meta" class={label} id="control">{labels.control}</h2>
      <p class="text-body">{copy.control}</p>
      <p class="mt-4"><button class="cursor-pointer border-0 bg-transparent p-0 font-bold text-signal underline decoration-signal/35 underline-offset-[0.24em] hover:decoration-signal" type="button" data-tracking-settings>{copy.open}</button></p>
    </Entry>
    <Entry as="section" padding="py-10" aria-labelledby="contact">
      <h2 slot="meta" class={label} id="contact">{labels.contact}</h2>
      <p class="text-body">{copy.contact} <a href={`mailto:${site.email}`}>{site.email}</a>{copy.contactEnd}</p>
    </Entry>
  </div>
</BaseLayout>

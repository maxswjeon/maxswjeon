---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entry from '../ui/Entry.astro';
import PageHead from '../ui/PageHead.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Tags from '../ui/Tags.astro';
import { site } from '../../config';
import type { Project, ProjectGroup } from '../../content/public';
import { period, type Locale } from '../../i18n';

interface ExperienceSummary {
  id: string;
  organization: string;
  role: string;
  period: string;
}

interface Props {
  locale: Locale;
  content: {
    approaches: readonly { title: readonly string[]; body: string }[];
    projectGroupLabels: Record<ProjectGroup, string>;
    projects: Project[];
    purpose: { headline: readonly string[]; introduction: readonly string[] };
    primaryExperience: ExperienceSummary;
    experienceEntries: readonly ExperienceSummary[];
  };
}

const { locale, content } = Astro.props;
const { approaches, projectGroupLabels, projects, purpose } = content;
const experience = [content.primaryExperience, ...content.experienceEntries];
const years = experience.flatMap((item) => item.period.match(/\d{4}/g) ?? []).map(Number);
const featured = projects.filter((project) => project.featured);
const headingLabel = (lines: readonly string[]) => lines.join(' ').replaceAll(' ', ' ');
const copy = locale === 'ko' ? {
  description: '반복되는 수고를 줄이는 제품과 시스템을 만들고 경험과 지식을 나눕니다.',
  approachTitle: ['도구부터 운영까지', '일의 흐름을 살핍니다'],
  experience: '경력',
  selectedTitle: ['생각은 시스템이 되어', '실제로 작동합니다'],
  allWork: '모든 작업 보기',
  writingTitle: ['배운 것을 설명하며', '다시 이해합니다'],
  writingBody: '기술과 운영에서 얻은 경험을 글로 정리합니다.',
  writingLink: 'swjeon.dev에서 읽기',
} : {
  description: 'Products and systems that reduce repetitive work, supported by shared experience and knowledge.',
  approachTitle: ['See the whole workflow,', 'from tools to operations'],
  experience: 'Experience',
  selectedTitle: ['Ideas become', 'working systems'],
  allWork: 'View all work',
  writingTitle: ['Write to understand', 'Share what you learn'],
  writingBody: 'Technical and operational lessons, documented and shared.',
  writingLink: 'Read on swjeon.dev',
};
const workHref = getRelativeLocaleUrl(locale, 'work');
---

<BaseLayout description={copy.description} pathname={`/${locale}/`} {locale}>
  <PageHead lines={purpose.headline} keepLines={locale === 'ko'} size="display">
    <p class="mt-8 max-w-[40rem] text-body" data-purpose-introduction>
      {purpose.introduction.map((line, index) => <span class:list={['block', index === 0 ? 'font-semibold' : 'text-soft']}>{line}</span>)}
    </p>
  </PageHead>

  <section class="mt-section" id="approach" aria-labelledby="approach-title">
    <SectionTitle id="approach-title" lines={copy.approachTitle} />
    <ul class="mt-2">
      {approaches.map((approach) => (
        <Entry as="li">
          <h3 class="text-[1.1875rem] leading-heading font-bold tracking-[-0.02em]" aria-label={headingLabel(approach.title)}>
            {approach.title.map((line, index) => <Fragment>{index > 0 && ' '}<span class="block split:inline" aria-hidden="true">{line}</span></Fragment>)}
          </h3>
          <p class="mt-1.5 text-body text-soft">{approach.body}</p>
        </Entry>
      ))}
    </ul>
  </section>

  <section class="mt-section" aria-labelledby="home-experience-title">
    <div class="flex items-baseline gap-3">
      <SectionTitle id="home-experience-title" lines={copy.experience} />
      <span class="text-meta text-soft tabular-nums">{Math.min(...years)}–{Math.max(...years)}</span>
    </div>
    <ol class="mt-2">
      {experience.map((item) => (
        <Entry as="li" link>
          <Fragment slot="meta">{period(item.period)}</Fragment>
          <h3 class="text-[1.1875rem] leading-heading font-bold tracking-[-0.02em]">
            <a class="no-underline after:absolute after:inset-0 after:rounded-xl group-hover:text-signal" href={`${workHref}#${item.id}`}>{item.organization}</a>
          </h3>
          <p class="mt-0.5 text-body text-soft">{item.role.replace(' · ', ', ')}</p>
        </Entry>
      ))}
    </ol>
  </section>

  <section class="mt-section" aria-labelledby="selected-title">
    <SectionTitle id="selected-title" lines={copy.selectedTitle} />
    <ul class="mt-2">
      {featured.map((project) => (
        <Entry as="li" link>
          <Fragment slot="meta">{projectGroupLabels[project.group]}</Fragment>
          <h3 class="text-[1.1875rem] leading-heading font-bold tracking-[-0.02em]">
            <a class="no-underline after:absolute after:inset-0 after:rounded-xl group-hover:text-signal" href={getRelativeLocaleUrl(locale, `work/${project.slug}`)}>{project.title}</a>
          </h3>
          <p class="mt-1.5 text-body text-soft">{project.summary}</p>
          <Tags items={project.eyebrow.split(' · ')} />
        </Entry>
      ))}
    </ul>
    <p class="mt-4"><a class="font-bold text-signal" href={workHref}>{copy.allWork}</a></p>
  </section>

  <section class="mt-section" aria-labelledby="writing-title">
    <SectionTitle id="writing-title" lines={copy.writingTitle} />
    <p class="mt-3 max-w-[40rem] text-body text-soft">{copy.writingBody}</p>
    <p class="mt-4"><a class="font-bold text-signal" href={site.writing} target="_blank" rel="noopener">{copy.writingLink} <span aria-hidden="true">↗</span></a></p>
  </section>
</BaseLayout>

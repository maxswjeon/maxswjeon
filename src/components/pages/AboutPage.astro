---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entry from '../ui/Entry.astro';
import PageHead from '../ui/PageHead.astro';
import { site } from '../../config';
import { period, type Locale } from '../../i18n';

interface ExperienceSummary {
  organization: string;
  role: string;
  period: string;
  body: string;
  link?: string;
  organizationLinks?: readonly { label: string; href: string }[];
}

interface Props {
  locale: Locale;
  primaryExperience: ExperienceSummary;
  experienceEntries: readonly ExperienceSummary[];
}

const { locale, primaryExperience, experienceEntries } = Astro.props;
const copy = locale === 'ko' ? {
  title: 'About',
  description: '제품 개발과 운영, 문서와 지식 공유를 하나의 흐름으로 잇는 방식을 소개합니다.',
  heading: ['일을 더 잘할 수 있는', '환경을 만듭니다'],
  intro: '제품이 실제로 쓰이고 오래 운영되도록 개발부터 인프라, 운영까지 함께 다뤄 왔습니다.',
  whyLabel: '만드는 이유',
  why: '사람들이 제가 만든 프로그램과 시스템을 편리하게 쓰는 모습을 보며 엔지니어링의 보람을 배웠습니다. 불필요한 수고를 줄이고 복잡한 일을 이해하고 활용할 수 있는 형태로 바꾸는 데 관심을 둡니다.',
  howLabel: '일하는 방식',
  how: '제품 개발과 운영, 인프라를 하나의 흐름으로 바라봅니다. 문제를 실제로 겪는 사람에게 필요한 경험을 구현합니다. 테스트와 자동화로 반복되는 일을 줄이고 문서와 지식 공유로 다음 사람이 이어서 일할 수 있게 합니다.',
  experience: '경력',
  viewWork: '경력과 작업 살펴보기',
  share: '나누는 일',
  shareBody: '배포·운영 경험과 기술 이슈를 동료들과 나누고 재사용할 수 있는 오픈소스를 정리해 왔습니다. UbuCon Asia 2022에서는 동아리방 재실 확인 프로젝트의 구현 경험을 발표했고 Docker 세미나와 인프라 스터디를 진행했습니다.',
  read: '글 읽기',
  relatedOrganizations: '관련 조직',
} : {
  title: 'About',
  description: 'This approach connects product development, operations, infrastructure, documentation, and knowledge sharing.',
  heading: ['Building tools that', 'make work easier'],
  intro: 'Work spans product development, infrastructure, and operations, with an emphasis on software that stays useful and maintainable after launch.',
  whyLabel: 'Why',
  why: 'Engineering is most rewarding when a program or system makes someone’s work noticeably easier. That means removing avoidable effort and making complex tasks easier to understand and act on.',
  howLabel: 'How',
  how: 'Products, operations, and infrastructure are treated as one connected system. Work starts with the people closest to the problem, uses testing and automation to reduce repetitive work, and leaves clear documentation so others can build on it.',
  experience: 'Experience',
  viewWork: 'Explore experience and projects',
  share: 'Sharing',
  shareBody: 'Technical lessons from deployments and operations are shared through writing, alongside reusable open-source tools. A UbuCon Asia 2022 talk covered the implementation of a real-time clubroom occupancy service. Other knowledge-sharing work includes Docker seminars and infrastructure study sessions.',
  read: 'Read articles',
  relatedOrganizations: 'Related organizations',
};
const breadcrumbs = [
  { name: 'Home', path: `/${locale}/` },
  { name: 'About', path: `/${locale}/about/` },
];
const label = 'text-label font-bold text-ink';
---

<BaseLayout title={copy.title} description={copy.description} pathname={`/${locale}/about/`} {breadcrumbs} {locale}>
  <PageHead lines={copy.heading} keepLines={locale === 'ko'}>
    <p class="mt-8 max-w-[40rem] text-body text-soft">{copy.intro}</p>
  </PageHead>

  <div class="mt-section divide-y divide-rule border-y border-rule">
    <Entry as="section" padding="py-10" aria-labelledby="why">
      <h2 slot="meta" class={label} id="why">{copy.whyLabel}</h2>
      <p class="text-body">{copy.why}</p>
    </Entry>
    <Entry as="section" padding="py-10" aria-labelledby="how">
      <h2 slot="meta" class={label} id="how">{copy.howLabel}</h2>
      <p class="text-body">{copy.how}</p>
    </Entry>
    <Entry as="section" padding="py-10" aria-labelledby="experience">
      <h2 slot="meta" class={label} id="experience">{copy.experience}</h2>
      <div class="grid gap-8">
        {[primaryExperience, ...experienceEntries].map((item) => (
          <article>
            <p class="flex flex-wrap gap-x-3 text-meta text-soft tabular-nums"><span class="font-semibold text-ink">{period(item.period)}</span><span>{item.role.replace(' · ', ', ')}</span></p>
            <h3 class="mt-1 text-[1.1875rem] leading-heading font-bold tracking-[-0.02em] text-balance">
              {item.link
                ? <a href={item.link} target="_blank" rel="noopener">{item.organization} <span aria-hidden="true">↗</span></a>
                : item.organization}
            </h3>
            {item.organizationLinks && (
              <ul class="mt-1 flex flex-wrap gap-x-4 text-meta text-soft" aria-label={`${item.organization} ${copy.relatedOrganizations}`}>
                {item.organizationLinks.map((organization) => <li><a href={organization.href} target="_blank" rel="noopener">{organization.label} ↗</a></li>)}
              </ul>
            )}
            <p class="mt-2 text-body text-soft">{item.body}</p>
          </article>
        ))}
        <p><a class="font-bold text-signal" href={getRelativeLocaleUrl(locale, 'work')}>{copy.viewWork}</a></p>
      </div>
    </Entry>
    <Entry as="section" padding="py-10" aria-labelledby="share">
      <h2 slot="meta" class={label} id="share">{copy.share}</h2>
      <p class="text-body">{copy.shareBody}</p>
      <p class="mt-4"><a class="font-bold text-signal" href={site.writing} target="_blank" rel="noopener">{copy.read} <span aria-hidden="true">↗</span></a></p>
    </Entry>
  </div>
</BaseLayout>

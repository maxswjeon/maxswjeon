---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entry from '../ui/Entry.astro';
import PageHead from '../ui/PageHead.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { period, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  archive: readonly (readonly [string, string, string?])[];
}

const { locale, archive } = Astro.props;
const copy = locale === 'ko' ? {
  title: 'Project archive',
  description: '웹과 하드웨어, 자동화와 커뮤니티 분야의 이전 작업을 모았습니다.',
  heading: '이전 작업의 기록',
  intro: '그동안 만든 웹·하드웨어·자동화·커뮤니티 프로젝트를 한곳에 정리했습니다.',
  listTitle: '작은 실험과 오래된 프로젝트',
} : {
  title: 'Project archive',
  description: 'An archive of earlier web, hardware, automation, and community projects.',
  heading: 'Earlier work',
  intro: 'Earlier projects spanning web services, hardware, automation, and community tools.',
  listTitle: 'Experiments and earlier projects',
};
const breadcrumbs = [
  { name: 'Home', path: `/${locale}/` },
  { name: 'Work', path: `/${locale}/work/` },
  { name: 'Archive', path: `/${locale}/work/archive/` },
];
// A leading "2021.03-2021.04 · " date moves into the meta column.
const split = (detail: string) => {
  const match = detail.match(/^(\d{4}\.\d{2}(?:-\d{4}\.\d{2})?) · (.+)$/);
  return match ? { when: period(match[1]), text: match[2] } : { when: '', text: detail };
};
---

<BaseLayout title={copy.title} description={copy.description} pathname={`/${locale}/work/archive/`} {breadcrumbs} {locale}>
  <PageHead lines={copy.heading}>
    <p class="mt-8 max-w-[40rem] text-body text-soft">{copy.intro}</p>
  </PageHead>
  <section class="mt-section" aria-labelledby="archive-title">
    <SectionTitle id="archive-title" lines={copy.listTitle} />
    <ul class="mt-4 divide-y divide-rule border-y border-rule">
      {archive.map(([title, detail, id]) => {
        const { when, text } = split(detail);
        return (
          <Entry as="li" {id} padding="py-5">
            {when && <Fragment slot="meta">{when}</Fragment>}
            <h3 class="text-[1.0625rem] leading-heading font-bold tracking-[-0.015em]">{title}</h3>
            <p class="mt-0.5 text-body text-soft">{text}</p>
          </Entry>
        );
      })}
    </ul>
  </section>
</BaseLayout>

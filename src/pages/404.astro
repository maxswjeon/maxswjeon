---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/ui/PageHead.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다." pathname="/404.html" noindex localized={false}>
  <PageHead lines={['요청한 페이지가', '존재하지 않습니다']} keepLines>
    <p class="mt-8 max-w-[40rem] text-body text-soft">주소가 바뀌었거나 페이지가 사라졌을 수 있습니다. 홈에서 다시 시작하거나 작업 목록을 살펴보세요.</p>
    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-bold text-signal print:hidden">
      <a href="/ko/">홈으로</a>
      <a href="/ko/work/">작업 보기</a>
      <a href="/en/" lang="en">English</a>
    </p>
  </PageHead>
</BaseLayout>

---
import LocaleRedirectPage from '../../components/LocaleRedirectPage.astro';
import { projects } from '../../content/public';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
---

<LocaleRedirectPage path={`/work/${slug}/`} />

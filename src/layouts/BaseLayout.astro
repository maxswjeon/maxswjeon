---
import Tracking from '../components/Tracking.astro';
import { Image, getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import profileImage from '../assets/profile.jpg';
import { site } from '../config';
import { defaultLocale, removeLocalePrefix, ui, type Locale } from '../i18n';
import '../styles/tailwind.css';

type Breadcrumb = { name: string; path: string };

interface Props {
  title?: string;
  description: string;
  pathname: string;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  locale?: Locale;
  localized?: boolean;
}

const {
  title,
  description,
  pathname,
  breadcrumbs = [],
  noindex = false,
  locale = defaultLocale,
  localized = true,
} = Astro.props;
const copy = ui[locale];
const displayName = locale === 'ko' ? site.name : site.englishName;
const alternateName = locale === 'ko' ? site.englishName : site.name;
const pageTitle = title ? `${title} :: ${displayName}` : `${displayName} :: Engineer`;
const socialImageAlt = locale === 'ko'
  ? '전상완, Engineer :: 세상이 더 효율적으로 움직이고 사람들이 더 능숙하게 일할 수 있도록'
  : 'Sangwan Jeon, Engineer :: building tools that help the world run more efficiently and people work more effectively';
const canonical = new URL(pathname, site.url).toString();
const localePath = removeLocalePrefix(pathname).replace(/^\//, '');
const localeUrls = localized
  ? {
      ko: getRelativeLocaleUrl('ko', localePath),
      en: getRelativeLocaleUrl('en', localePath),
    }
  : { ko: getRelativeLocaleUrl('ko'), en: getRelativeLocaleUrl('en') };
const socialImage = new URL('/og.png', site.url).toString();
const favicon = await getImage({ src: profileImage, width: 64, height: 64, format: 'png' });
const currentPath = Astro.url.pathname;
const navItems = [
  { label: copy.nav.about, href: getRelativeLocaleUrl(locale, 'about'), current: currentPath.startsWith(`/${locale}/about`) },
  { label: copy.nav.work, href: getRelativeLocaleUrl(locale, 'work'), current: currentPath.startsWith(`/${locale}/work`) },
  { label: copy.nav.writing, href: site.writing, external: true },
];
const other = copy.otherLocale;
const otherLocaleUrl = localeUrls[other.locale];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  alternateName,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Engineer',
  sameAs: [site.github, site.writing],
};
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, site.url).toString(),
      })),
    }
  : null;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const naverSiteVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {naverSiteVerification && <meta name="naver-site-verification" content={naverSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    <link rel="canonical" href={canonical} />
    {localized && <link rel="alternate" hreflang="ko" href={new URL(localeUrls.ko, site.url)} />}
    {localized && <link rel="alternate" hreflang="en" href={new URL(localeUrls.en, site.url)} />}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(localeUrls.ko, site.url)} />}
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:site_name" content={`${displayName} · ${alternateName}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body class="bg-mist text-ink">
    <a class="fixed top-0 left-0 z-[1000] -translate-y-[120%] bg-ink px-4 py-3 font-semibold text-white focus:translate-y-0" href="#main-content">{copy.skip}</a>
    <div class="mx-auto w-[var(--shell)] split:grid split:grid-cols-[minmax(14rem,19rem)_minmax(0,1fr)] split:gap-x-[clamp(3rem,6vw,6.5rem)]">
      <header class="flex flex-col pt-6 split:sticky split:top-0 split:-mx-2 split:h-svh split:overflow-y-auto split:px-2 split:py-rail print:static print:h-auto">
        <a class="flex w-fit items-center gap-4 no-underline split:flex-col split:items-start split:gap-6" href={getRelativeLocaleUrl(locale)} aria-label={copy.homeLabel}>
          <Image
            class="size-14 shrink-0 rounded-full split:size-28"
            src={profileImage}
            alt={locale === 'ko' ? '전상완 프로필' : 'Portrait of Sangwan Jeon'}
            widths={[56, 112, 224]}
            sizes="(min-width: 53.75rem) 112px, 56px"
            priority
          />
          <span class="grid gap-1">
            <span class="text-[1.375rem] leading-[1.2] font-extrabold tracking-[-0.04em] split:text-[2.125rem]">{displayName}</span>
            <span class="text-[0.9375rem] leading-[1.4] text-soft"><span lang={locale === 'ko' ? 'en' : 'ko'}>{alternateName}</span>, Engineer</span>
          </span>
        </a>
        <p class="mt-5 hidden max-w-[17rem] text-[0.9375rem] leading-[1.7] text-soft split:block">{copy.role}</p>
        <nav class="mt-4 flex flex-wrap items-center gap-x-6 print:hidden split:mt-10 split:grid split:gap-0" aria-label={copy.primaryNav}>
          {navItems.map((item) => (
            <a
              class="group flex min-h-11 items-center gap-3 text-[0.9375rem] font-semibold text-soft no-underline hover:text-ink aria-[current=page]:text-ink max-split:aria-[current=page]:underline max-split:aria-[current=page]:decoration-signal max-split:aria-[current=page]:decoration-2 max-split:aria-[current=page]:underline-offset-[0.45em] split:min-h-10"
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'me noopener' : undefined}
            >
              <span class="hidden h-0.5 w-5 bg-rule transition-[width,background-color] duration-150 group-hover:w-8 group-aria-[current=page]:w-10 group-aria-[current=page]:bg-signal split:block" aria-hidden="true"></span>
              {item.label}{item.external && <span aria-hidden="true"> ↗</span>}
            </a>
          ))}
          <a class="flex min-h-11 items-center text-[0.9375rem] text-soft no-underline hover:text-ink split:hidden" href={otherLocaleUrl} lang={other.locale}>{other.label}</a>
        </nav>
        <div class="mt-auto hidden gap-2 pt-10 print:hidden split:grid">
          <a class="w-fit font-bold text-signal" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="flex flex-wrap gap-x-5 gap-y-1 text-meta text-soft">
            <a href={site.github} target="_blank" rel="me noopener">GitHub <span aria-hidden="true">↗</span></a>
            <a href={otherLocaleUrl} lang={other.locale}>{other.label}</a>
          </p>
        </div>
      </header>
      <div class="min-w-0">
        <main id="main-content" class="pt-12 split:pt-rail">
          <slot />
        </main>
        <footer class="mt-section flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-rule pt-6 pb-12 text-meta text-soft print:hidden">
          <a class="font-semibold text-signal split:hidden" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="split:hidden" href={site.github} target="_blank" rel="me noopener">GitHub <span aria-hidden="true">↗</span></a>
          <a href={getRelativeLocaleUrl(locale, 'privacy')}>{copy.privacy}</a>
          <button class="cursor-pointer border-0 bg-transparent p-0 text-inherit underline decoration-rule underline-offset-[0.24em] hover:decoration-current" type="button" data-tracking-settings>{copy.trackingSettings}</button>
          <span class="split:ml-auto" lang="en">© {new Date().getFullYear()} {site.englishName}</span>
        </footer>
      </div>
    </div>
    <Tracking {locale} />
  </body>
</html>

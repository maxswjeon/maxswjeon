---
import Tracking from '../components/Tracking.astro';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import profileImage from '../assets/profile.jpg';
import { site } from '../config';
import { defaultLocale, removeLocalePrefix, ui, type Locale } from '../i18n';
import '../styles/tailwind.css';

type Breadcrumb = { name: string; path: string };

interface Props {
  title?: string;
  description: string;
  pathname: string;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  locale?: Locale;
  localized?: boolean;
}

const {
  title,
  description,
  pathname,
  breadcrumbs = [],
  noindex = false,
  locale = defaultLocale,
  localized = true,
} = Astro.props;
const copy = ui[locale];
const displayName = locale === 'ko' ? site.name : site.englishName;
const alternateName = locale === 'ko' ? site.englishName : site.name;
const pageTitle = title ? `${title} :: ${displayName}` : `${displayName} :: Engineer`;
const socialImageAlt = locale === 'ko'
  ? '전상완, Engineer :: 세상이 더 효율적으로 움직이고 사람들이 더 능숙하게 일할 수 있도록'
  : 'Sangwan Jeon, Engineer :: building tools that help the world run more efficiently and people work more effectively';
const canonical = new URL(pathname, site.url).toString();
const localePath = removeLocalePrefix(pathname).replace(/^\//, '');
const localeUrls = localized
  ? {
      ko: getRelativeLocaleUrl('ko', localePath),
      en: getRelativeLocaleUrl('en', localePath),
    }
  : { ko: getRelativeLocaleUrl('ko'), en: getRelativeLocaleUrl('en') };
const socialImage = new URL('/og.png', site.url).toString();
const currentPath = Astro.url.pathname;
const aboutActive = currentPath.startsWith(`/${locale}/about`);
const workActive = currentPath.startsWith(`/${locale}/work`);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: displayName,
  alternateName,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Engineer',
  sameAs: [site.github, site.writing],
};
const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, site.url).toString(),
      })),
    }
  : null;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const naverSiteVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {naverSiteVerification && <meta name="naver-site-verification" content={naverSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    <link rel="canonical" href={canonical} />
    {localized && <link rel="alternate" hreflang="ko" href={new URL(localeUrls.ko, site.url)} />}
    {localized && <link rel="alternate" hreflang="en" href={new URL(localeUrls.en, site.url)} />}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(localeUrls.ko, site.url)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://naver.github.io" crossorigin />
    <link rel="preload" href="https://naver.github.io/d2-coding-font/fonts/D2Coding-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:site_name" content={`${displayName} · ${alternateName}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body>
    <a class="fixed top-0 left-0 z-[1000] -translate-y-[120%] bg-[var(--signal)] px-[1.1rem] py-[0.85rem] text-[var(--ink)] focus:translate-y-0" href="#main-content">{copy.skip}</a>
    <header class="relative z-10 mx-auto flex min-h-28 w-[var(--shell)] items-center justify-between gap-12 border-b border-[var(--rule)] max-[719px]:min-h-0 max-[719px]:gap-4 max-[719px]:py-4">
      <a class="inline-flex items-center gap-3 text-[var(--text)] no-underline hover:text-[var(--text)]" href={getRelativeLocaleUrl(locale)} aria-label={copy.homeLabel}>
        <Image
          class="h-10 w-10 shrink-0 border border-white/10 object-cover"
          src={profileImage}
          alt={locale === 'ko' ? '전상완 프로필' : 'Portrait of Sangwan Jeon'}
          widths={[40, 80]}
          sizes="40px"
          priority
        />
        <span class="hidden gap-[0.2rem] leading-none min-[720px]:grid">
          <strong class="text-[length:var(--size-small)] tracking-[-0.02em]">{displayName}</strong>
          <small class="font-mono text-[length:var(--size-meta)] font-normal tracking-normal text-[var(--text-soft)]" lang={locale === 'ko' ? 'en' : 'ko'}>{alternateName}</small>
        </span>
      </a>
      <div class="flex items-center gap-3 md:gap-8">
        <nav class="flex items-center gap-[clamp(1.5rem,4vw,3.75rem)] print:hidden max-[719px]:ml-auto max-[719px]:w-auto max-[719px]:justify-end max-[719px]:gap-[clamp(0.7rem,4vw,1.5rem)]" aria-label={locale === 'ko' ? '주요 메뉴' : 'Primary navigation'}>
          <a class="inline-flex items-center gap-[0.45rem] py-[1.1rem] font-sans text-[length:var(--size-small)] font-semibold text-[var(--text-soft)] no-underline hover:text-[var(--text)] aria-[current=page]:text-[var(--text)] max-[719px]:min-h-11 max-[719px]:py-[0.7rem] max-[719px]:text-[length:var(--size-meta)]" href={getRelativeLocaleUrl(locale, 'about')} aria-current={aboutActive ? 'page' : undefined}>About {aboutActive && <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--signal)]" aria-hidden="true"></span>}</a>
          <a class="inline-flex items-center gap-[0.45rem] py-[1.1rem] font-sans text-[length:var(--size-small)] font-semibold text-[var(--text-soft)] no-underline hover:text-[var(--text)] aria-[current=page]:text-[var(--text)] max-[719px]:min-h-11 max-[719px]:py-[0.7rem] max-[719px]:text-[length:var(--size-meta)]" href={getRelativeLocaleUrl(locale, 'work')} aria-current={workActive ? 'page' : undefined}>Work {workActive && <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--signal)]" aria-hidden="true"></span>}</a>
          <a class="inline-flex items-center gap-[0.45rem] py-[1.1rem] font-sans text-[length:var(--size-small)] font-semibold text-[var(--text-soft)] no-underline hover:text-[var(--text)] max-[719px]:min-h-11 max-[719px]:py-[0.7rem] max-[719px]:text-[length:var(--size-meta)]" href={site.writing} target="_blank" rel="me noopener">Writing <span class="hidden text-[var(--signal)] min-[720px]:inline" aria-hidden="true">↗</span></a>
        </nav>
        <details class="group relative font-mono text-sm leading-meta">
          <summary class="min-w-10 cursor-pointer list-none border border-[var(--rule)] px-2 py-1 text-center text-[var(--text-soft)] marker:content-none" aria-label={`${copy.language}: ${copy.languageName}`}>{locale.toUpperCase()}</summary>
          <ul class="absolute right-0 z-20 mt-2 grid min-w-32 list-none border border-[var(--rule)] bg-[var(--canvas)] p-1 shadow-2xl">
            <li><a class="block px-3 py-2 no-underline" href={localeUrls.ko} lang="ko" aria-current={locale === 'ko' ? 'page' : undefined}>한국어</a></li>
            <li><a class="block px-3 py-2 no-underline" href={localeUrls.en} lang="en" aria-current={locale === 'en' ? 'page' : undefined}>English</a></li>
          </ul>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="relative mx-auto grid min-h-[34rem] w-[var(--shell)] grid-cols-[minmax(0,2fr)_minmax(14rem,1fr)] items-stretch gap-16 bg-[var(--canvas)] pt-[clamp(4rem,8vw,7rem)] pb-8 text-[var(--text)] print:hidden max-[719px]:min-h-[32rem] max-[719px]:grid-cols-1">
      <div class="flex flex-col items-start">
        <p class="mt-auto mb-8 max-w-[12ch] whitespace-pre-line text-[clamp(2.25rem,4.2vw,4.25rem)] leading-heading font-bold tracking-[-0.045em] max-[719px]:mt-20">{copy.footerTitle}</p>
        <a class="text-[clamp(1rem,2vw,1.35rem)] font-[680] text-[var(--signal)]" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="flex flex-col items-end justify-between font-mono text-[length:var(--size-meta)] text-[var(--text-soft)] max-[719px]:items-start max-[719px]:gap-12">
        <div class="flex flex-col items-end gap-4 max-[719px]:items-start">
          <a href={site.github} target="_blank" rel="me noopener">GitHub <span aria-hidden="true">↗</span></a>
          <a href={getRelativeLocaleUrl(locale, 'privacy')}>{copy.privacy}</a>
          <button class="cursor-pointer border-0 bg-transparent p-0 text-inherit underline underline-offset-[0.24em]" type="button" data-tracking-settings>{copy.trackingSettings}</button>
        </div>
        <span>© {new Date().getFullYear()} {site.englishName}</span>
      </div>
    </footer>
    <Tracking {locale} />
  </body>
</html>
